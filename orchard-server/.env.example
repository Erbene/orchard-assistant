# --- PostgreSQL (docker-compose "postgres" service + app/core/db.py) --
# The compose file reads POSTGRES_* to provision the container; the app reads
# them (or DATABASE_URL) to build its asyncpg pool. Local only - the port is
# bound to 127.0.0.1. Still set a real password; Postgres enforces it.
POSTGRES_USER=orchard
POSTGRES_PASSWORD=change-me-local
POSTGRES_DB=orchard
POSTGRES_HOST=localhost
POSTGRES_PORT=5433                        # compose publishes Postgres on host 5433 (5432 may be a native install)
# DATABASE_URL overrides the parts above if set:
# DATABASE_URL=postgresql+asyncpg://orchard:change-me-local@localhost:5433/orchard

# Connection pool (16-core host: generous but bounded; server max_connections=100)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- ChromaDB HTTP server (docker-compose "chromadb" service + app/core/vector_db.py)
CHROMA_HOST=localhost
CHROMA_PORT=8001                          # compose publishes Chroma on host 8001 (8000 = local uvicorn)
CHROMA_COLLECTION=orchard_knowledge      # tests override this -> orchard_knowledge_test

# --- Rachio Smart Irrigation API (app/services/rachio.py) -----------------
# Zones are read live from Rachio (read-only; edit zone config in the Rachio
# app). Optional: without a key the /api/v1/zones endpoints + the
# list_zones / trigger_rachio_watering MCP tools return 503 / a tool error,
# and the rest of the app is unaffected. Get a key at app.rach.io -> Account.
RACHIO_API_KEY=
RACHIO_BASE_URL=https://api.rach.io/1/public

# --- Irrigation workflow (app/irrigation/) ------------------------------
# Orchard location -> NWS gridpoint forecast + nearest-station observations.
# Unset -> weather calls return {"available": false} (non-fatal).
ORCHARD_LAT=
ORCHARD_LON=
# NWS REQUIRES a User-Agent identifying your app + a contact. Set this.
NWS_USER_AGENT=orchard-assistant (you@example.com)
NWS_BASE_URL=https://api.weather.gov

# --- Uploaded source files ------------------------------------------------
ORCHARD_UPLOADS_DIR=./uploads

# --- Logging (app/core/logging.py) --------------------------------------
LOG_LEVEL=DEBUG             # CRITICAL | ERROR | WARNING | INFO | DEBUG
ENVIRONMENT=development     # production/staging -> JSON, development/local/test -> console
LOG_FORMAT=                 # "console" | "json" - overrides ENVIRONMENT; empty -> auto (isatty)

# --- Local LLM (Ollama) --------------------------------------------------
#   ollama serve && ollama pull qwen2.5:7b-instruct   # (and qwen2.5:14b if used)
OLLAMA_BASE_URL=http://localhost:11434
# Orchestrator / router (short structured output). REQUIRED - /api/v1/chat
# returns 503 without Ollama. Keep this small & fast; 7B routes reliably.
AGENT_MODEL=qwen2.5:7b-instruct
# Agronomist - grounded Q&A over retrieved notes. Defaults to AGENT_MODEL;
# set this to try a stronger model for answer quality without slowing routing.
#AGRONOMIST_MODEL=qwen2.5:14b
# Foreman JIT session summary (app/agent/foreman.py). OPTIONAL - falls back to
# a templated summary. 14B wants a GPU; on CPU use qwen2.5:7b-instruct.
FOREMAN_MODEL=qwen2.5:14b

# --- LangSmith tracing - opt in -------------------------------------
# true + an API key -> every ChatOllama call and LangGraph run is traced, plus
# named spans for kb.search / agronomist.answer / orchestrator.classify
# (app/core/tracing.py). Secrets are stripped from logged inputs. Tests force
# this off (conftest).
LANGCHAIN_TRACING_V2=false
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=orchard-dev

# --- In-process supervisor loop (uvicorn lifespan) -----------------------
# Default on when unset. Set 0/false/off to disable (pytest sets 0). Same path as Run Supervision Task.
#ORCHARD_SUPERVISOR_LOOP=

# --- Demo mode (irrigation supervisor scenarios) -------------------------
# When true, /irrigation shows three preset scenarios that pin stub moisture,
# rain, forecast, and last-watered. Select a scenario, click Apply, then Run
# Supervision Task (does not auto-run). Set LANGCHAIN_TRACING_V2=true and a
# LANGCHAIN_API_KEY to see irrigation.tot_solver and irrigation-demo:* traces.
ORCHARD_DEMO=false
