# --- Storage -------------------------------------------------------------
ORCHARD_DB_PATH=./orchard.db
ORCHARD_CHROMA_PATH=./chroma
ORCHARD_UPLOADS_DIR=./uploads

# --- Logging (app/core/logging.py) ----------------------------------
LOG_LEVEL=DEBUG             # CRITICAL | ERROR | WARNING | INFO | DEBUG
ENVIRONMENT=development     # production/staging -> JSON, development/local/test -> console
LOG_FORMAT=                 # "console" | "json" — overrides ENVIRONMENT; empty -> auto (isatty)

# --- LangSmith tracing (app/agent) -------------------------------------
# https://smith.langchain.com  ->  Settings -> API Keys
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=lsv2_pt_your_key_here
LANGCHAIN_PROJECT=orchard-agent
